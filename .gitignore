# Personal photos never enter the repo — that is the whole point of keeping
# them in Supabase Storage. Originals go in incoming/, web-ready copies in
# outgoing/, and neither is tracked.
incoming/
outgoing/
she/
photos/
originals/

# Credentials. The service-role key bypasses every RLS policy in
# supabase/schema.sql — it must never be committed.
.env
.env.*
!.env.example

